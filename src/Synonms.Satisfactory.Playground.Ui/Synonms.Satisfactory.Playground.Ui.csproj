<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
        <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" />
        <PackageReference Include="Synonms.CarbonBlazor" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\Synonms.Satisfactory.Playground.Contract\Synonms.Satisfactory.Playground.Contract.csproj" />
    </ItemGroup>

    <ItemGroup>
      <_ContentIncludedByDefault Remove="Features\Requests\Pages\Request.razor" />
      <_ContentIncludedByDefault Remove="Features\Requests\Pages\Requests.razor" />
      <_ContentIncludedByDefault Remove="Features\Requests\Pages\WorkItem.razor" />
      <_ContentIncludedByDefault Remove="Features\Requests\_Imports.razor" />
    </ItemGroup>

</Project>
