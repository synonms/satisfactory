@page "/requests"

<PageTitle>Requests</PageTitle>

<CarbonBlazorPane Title="Requests">
    @if (_requests is null)
    {
        <CarbonBlazorLoadingSpinner></CarbonBlazorLoadingSpinner>
    }
    else
    {
        <CarbonBlazorDataTable @ref="@_dataTable" TModel="RequestResource" Models="@_requests" TotalSize="@_requests.Count" Offset="0" PageLimit="10" ShouldFillPane="true">
            <ToolbarButtons>
                <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.TextOnly" Text="XS" ClickedCallback="@(() => _dataTable.Resize(CarbonBlazorDataTableRowSize.ExtraSmall))"></CarbonBlazorButton>
                <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.TextOnly" Text="S" ClickedCallback="@(() => _dataTable.Resize(CarbonBlazorDataTableRowSize.Small))"></CarbonBlazorButton>
                <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.TextOnly" Text="M" ClickedCallback="@(() => _dataTable.Resize(CarbonBlazorDataTableRowSize.Medium))"></CarbonBlazorButton>
                <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.TextOnly" Text="L" ClickedCallback="@(() => _dataTable.Resize(CarbonBlazorDataTableRowSize.Large))"></CarbonBlazorButton>
                <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.TextOnly" Text="XL" ClickedCallback="@(() => _dataTable.Resize(CarbonBlazorDataTableRowSize.ExtraLarge))"></CarbonBlazorButton>
                <CarbonBlazorButton Display="CarbonBlazorButtonDisplay.TextAndIcon" IconType="CarbonBlazorIconType.Add" Text="Add" ClickedCallback="@CreateRequestAsync"></CarbonBlazorButton>
            </ToolbarButtons>
            <HeaderRowTemplate>
                <CarbonBlazorDataTableHeaderCell>Id</CarbonBlazorDataTableHeaderCell>
                <CarbonBlazorDataTableHeaderCell></CarbonBlazorDataTableHeaderCell>
            </HeaderRowTemplate>
            <DataRowTemplate>
                <CarbonBlazorDataTableDataCell>@context.Id</CarbonBlazorDataTableDataCell>
                <CarbonBlazorDataTableDataCell>
                    <CarbonBlazorButtonSet Style="justify-content: end;">
                        <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.IconOnly" IconType="CarbonBlazorIconType.Search" ClickedCallback="@(() => ReadRequest(context))"></CarbonBlazorButton>
                    </CarbonBlazorButtonSet>
                </CarbonBlazorDataTableDataCell>
            </DataRowTemplate>
        </CarbonBlazorDataTable>
    }
</CarbonBlazorPane>

@code {
    private CarbonBlazorDataTable<RequestResource> _dataTable = null!;
    private List<RequestResource>? _requests;

    [Inject]
    public required HttpClient HttpClient { get; set; }
    
    [Inject]
    public required INotificationBroker NotificationBroker { get; set; }

    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await RefreshRequestsAsync();
    }

    private async Task RefreshRequestsAsync()
    {
        try
        {
            _requests = await HttpClient.GetFromJsonAsync<List<RequestResource>>("api/requests");
        }
        catch (Exception exception)
        {
            Console.WriteLine($"[EXCEPTION] GetRequests request failed: {exception.Message}");
            NotificationBroker.Send("API Error", "GetRequests request threw an exception.", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Error);
        }
    }

    private Task CreateRequestAsync()
    {
        // TODO
        NotificationBroker.Send("Unsupported", "Creating requests not yet supported.", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Error);

        return Task.CompletedTask;
    }

    private void ReadRequest(RequestResource request)
    {
        NavigationManager.NavigateTo($"/requests/{request.Id}");
    }
}
