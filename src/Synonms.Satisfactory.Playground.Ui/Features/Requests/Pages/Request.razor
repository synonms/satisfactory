@page "/requests/{id}"

<PageTitle>Request</PageTitle>

<CarbonBlazorPane Title="Request">
    @if (_request is null)
    {
        <CarbonBlazorLoadingSpinner></CarbonBlazorLoadingSpinner>
    }
    else
    {
        <CarbonBlazorPane>
            <CarbonBlazorText>Id: @_request.Id</CarbonBlazorText>
        </CarbonBlazorPane>
        
        <CarbonBlazorDataTable @ref="@_dataTable" TModel="RequestResource.WorkItemIdentifier" Models="@_request.WorkItems" TotalSize="@_request.WorkItems.Count" Offset="0" PageLimit="10" ShouldFillPane="true">
            <ToolbarButtons>
                <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.TextOnly" Text="XS" ClickedCallback="@(() => _dataTable.Resize(CarbonBlazorDataTableRowSize.ExtraSmall))"></CarbonBlazorButton>
                <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.TextOnly" Text="S" ClickedCallback="@(() => _dataTable.Resize(CarbonBlazorDataTableRowSize.Small))"></CarbonBlazorButton>
                <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.TextOnly" Text="M" ClickedCallback="@(() => _dataTable.Resize(CarbonBlazorDataTableRowSize.Medium))"></CarbonBlazorButton>
                <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.TextOnly" Text="L" ClickedCallback="@(() => _dataTable.Resize(CarbonBlazorDataTableRowSize.Large))"></CarbonBlazorButton>
                <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.TextOnly" Text="XL" ClickedCallback="@(() => _dataTable.Resize(CarbonBlazorDataTableRowSize.ExtraLarge))"></CarbonBlazorButton>
                <CarbonBlazorButton Display="CarbonBlazorButtonDisplay.TextAndIcon" IconType="CarbonBlazorIconType.Add" Text="Add" ClickedCallback="@CreateWorkItemAsync"></CarbonBlazorButton>
            </ToolbarButtons>
            <HeaderRowTemplate>
                <CarbonBlazorDataTableHeaderCell>Id</CarbonBlazorDataTableHeaderCell>
                <CarbonBlazorDataTableHeaderCell></CarbonBlazorDataTableHeaderCell>
            </HeaderRowTemplate>
            <DataRowTemplate>
                <CarbonBlazorDataTableDataCell>@context.Id</CarbonBlazorDataTableDataCell>
                <CarbonBlazorDataTableDataCell>
                    <CarbonBlazorButtonSet Style="justify-content: end;">
                        <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.IconOnly" IconType="CarbonBlazorIconType.Search" ClickedCallback="@(() => ReadWorkItem(context))"></CarbonBlazorButton>
                        <CarbonBlazorButton Kind="CarbonBlazorButtonKind.Ghost" Display="CarbonBlazorButtonDisplay.IconOnly" IconType="CarbonBlazorIconType.Edit" ClickedCallback="@(() => UpdateWorkItem(context))"></CarbonBlazorButton>
                    </CarbonBlazorButtonSet>
                </CarbonBlazorDataTableDataCell>
            </DataRowTemplate>
        </CarbonBlazorDataTable>
    }
</CarbonBlazorPane>

@code {
    private CarbonBlazorDataTable<RequestResource.WorkItemIdentifier> _dataTable = null!;
    private RequestResource? _request;

    [Inject]
    public required HttpClient HttpClient { get; set; }
    
    [Inject]
    public required INotificationBroker NotificationBroker { get; set; }

    [Inject]
    public required NavigationManager NavigationManager { get; set; }

    [Parameter]
    public string Id { get; set; } = null!;
    
    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();

        await RefreshRequestAsync();
    }

    private async Task RefreshRequestAsync()
    {
        try
        {
            _request = await HttpClient.GetFromJsonAsync<RequestResource>("api/requests/" + Id);
        }
        catch (Exception exception)
        {
            Console.WriteLine($"[EXCEPTION] GetRequest request failed: {exception.Message}");
            NotificationBroker.Send("API Error", "GetRequest request threw an exception.", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Error);
        }
    }

    private Task CreateWorkItemAsync()
    {
        // TODO
        NotificationBroker.Send("Unsupported", "Creating work items not yet supported.", CarbonBlazorNotificationStyle.LowContrast, CarbonBlazorNotificationLevel.Error);

        return Task.CompletedTask;
    }
    
    private void ReadWorkItem(RequestResource.WorkItemIdentifier workItem)
    {
        NavigationManager.NavigateTo($"/requests/{Id}/work-items/{workItem.Id}");
    }
    
    private void UpdateWorkItem(RequestResource.WorkItemIdentifier workItem)
    {
        NavigationManager.NavigateTo($"/requests/{Id}/work-items/{workItem.Id}/edit");
    }
}
