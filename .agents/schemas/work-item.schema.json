{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Work Item",
  "description": "A structured representation of a work item",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "type", "created", "status", "request", "description", "tasks", "planStatus", "execution"],
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[0-9]{5}-[1-9][0-9]*$",
      "description": "Unique identifier for the work item"
    },
    "type": {
      "type": "string",
      "description": "Type of the work item",
      "enum": ["user-story", "chore", "bug", "documentation"]
    },
    "created": {
      "type": "string",
      "format": "date",
      "description": "Date work item was created"
    },
    "status": {
      "type": "string",
      "description": "Current status of the work item",
      "enum": ["new", "in-progress", "done", "blocked"]
    },
    "request": {
      "type": "string",
      "minLength": 1,
      "description": "Summary of the original request"
    },
    "source": {
      "type": "string",
      "format": "uri",
      "description": "External work item URL, omit when not applicable"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "description": "Detailed description of the work item"
    },
    "tasks": {
      "type": "array",
      "description": "First-class phase tasks and task activity history for this work item.",
      "items": {
        "$ref": "task.schema.json"
      }
    },
    "planStatus": {
      "description": "Approval state of the task plan. The single human gate for every work-item type.",
      "enum": [null, "draft", "approved"]
    },
    "intake": {
      "type": "array",
      "description": "Triage and design runs that produced or amended this work item, with their run metrics.",
      "items": {
        "$ref": "#/$defs/intakeActivity"
      }
    },
    "execution": {
      "$ref": "#/$defs/execution"
    },
    "acceptanceCriteria": {
      "type": "array",
      "description": "Acceptance criteria for the work item (User Story/Chore only)",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[0-9]{5}-[1-9][0-9]*\\.[1-9][0-9]*$"
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": ["id", "description"]
      },
      "minItems": 1
    },
    "stepsToReproduce": {
      "type": "string",
      "minLength": 1,
      "description": "Steps to reproduce issue (Bug only)"
    },
    "expectedResult": {
      "type": "string",
      "minLength": 1,
      "description": "Expected result of operation (Bug only)"
    },
    "actualResult": {
      "type": "string",
      "minLength": 1,
      "description": "Actual result of operation (Bug only)"
    },
    "content": {
      "type": "string",
      "minLength": 1,
      "description": "Content to be included (Documentation only)"
    },
    "specification": {
      "description": "Implementation specification for this work item",
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "specification.schema.json"
        }
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": { "type": { "enum": ["user-story", "chore"] } },
        "required": ["type"]
      },
      "then": {
        "required": ["acceptanceCriteria", "specification"],
        "not": {
          "anyOf": [
            { "required": ["stepsToReproduce"] },
            { "required": ["expectedResult"] },
            { "required": ["actualResult"] },
            { "required": ["content"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "bug" } },
        "required": ["type"]
      },
      "then": {
        "required": ["stepsToReproduce", "expectedResult", "actualResult"],
        "properties": { "specification": { "type": "null" } },
        "not": {
          "anyOf": [
            { "required": ["acceptanceCriteria"] },
            { "required": ["content"] }
          ]
        }
      }
    },
    {
      "if": {
        "properties": { "type": { "const": "documentation" } },
        "required": ["type"]
      },
      "then": {
        "required": ["content"],
        "properties": { "specification": { "type": "null" } },
        "not": {
          "anyOf": [
            { "required": ["acceptanceCriteria"] },
            { "required": ["stepsToReproduce"] },
            { "required": ["expectedResult"] },
            { "required": ["actualResult"] }
          ]
        }
      }
    }
  ],
  "$defs": {
    "nonNegativeInteger": {
      "type": "integer",
      "minimum": 0
    },
    "nonNegativeNumber": {
      "type": "number",
      "minimum": 0
    },
    "intakeActivity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ts", "agent", "result", "metrics"],
      "properties": {
        "ts": {
          "type": "string",
          "format": "date-time"
        },
        "agent": {
          "type": "string",
          "enum": ["triage", "software-architect"]
        },
        "result": {
          "type": "string",
          "minLength": 1
        },
        "metrics": {
          "$ref": "task.schema.json#/$defs/metrics"
        }
      }
    },
    "execution": {
      "type": "object",
      "description": "Service-managed routing budget, cumulative metrics, and escalations.",
      "additionalProperties": false,
      "required": ["branch", "budget", "totals", "escalations"],
      "properties": {
        "branch": {
          "type": ["string", "null"]
        },
        "budget": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "maxTaskAttempts",
            "maxReviewLoops",
            "maxValidationLoops",
            "maxTotalAgentRuns",
            "reviewLoops",
            "validationLoops",
            "totalAgentRuns"
          ],
          "properties": {
            "maxTaskAttempts": { "$ref": "#/$defs/nonNegativeInteger" },
            "maxReviewLoops": { "$ref": "#/$defs/nonNegativeInteger" },
            "maxValidationLoops": { "$ref": "#/$defs/nonNegativeInteger" },
            "maxTotalAgentRuns": { "$ref": "#/$defs/nonNegativeInteger" },
            "reviewLoops": { "$ref": "#/$defs/nonNegativeInteger" },
            "validationLoops": { "$ref": "#/$defs/nonNegativeInteger" },
            "totalAgentRuns": { "$ref": "#/$defs/nonNegativeInteger" }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["durationSeconds", "totalTokens", "estimatedCostUsd"],
          "properties": {
            "durationSeconds": { "$ref": "#/$defs/nonNegativeNumber" },
            "totalTokens": { "$ref": "#/$defs/nonNegativeInteger" },
            "estimatedCostUsd": { "$ref": "#/$defs/nonNegativeNumber" }
          }
        },
        "escalations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["ts", "taskId", "requirement", "evidence", "attempts", "recommendedAction"],
            "properties": {
              "ts": { "type": "string", "format": "date-time" },
              "taskId": { "type": ["string", "null"] },
              "requirement": { "type": "string", "minLength": 1 },
              "evidence": { "type": "string", "minLength": 1 },
              "attempts": { "$ref": "#/$defs/nonNegativeInteger" },
              "recommendedAction": { "type": "string", "minLength": 1 }
            }
          }
        }
      }
    }
  }
}